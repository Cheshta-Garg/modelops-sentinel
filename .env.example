# ==============================================================================
# ModelOps Sentinel - Environment Configuration Template
# ==============================================================================

# Application Core
PROJECT_NAME="ModelOps Sentinel"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="supersecretdevkeychangesinproductionatallcosts"

# Server Binding
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="modelops_db"
POSTGRES_USER="modelops_user"
POSTGRES_PASSWORD="modelops_password"
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# Logging & Telemetry
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Artifact Storage
ARTIFACT_DIR="./artifacts"
